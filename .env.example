# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Required ---
# Monday.com → Avatar (bottom-left) → Admin/Developer → API → "Generate token" (or
# Developer settings → My Access Tokens). Needs at least read access to the boards below.
MONDAY_API_TOKEN=

# An LLM API key — either a real OpenAI key (platform.openai.com → API Keys), or an OpenRouter
# key (openrouter.ai → Keys), pasted into this same variable either way. OpenRouter keys are
# auto-detected by their "sk-or-" prefix and routed to https://openrouter.ai/api/v1 instead of
# OpenAI directly (see config.py) — handy if you want to bill an OpenRouter balance instead of
# OpenAI/Anthropic credits directly. You can also set OPENROUTER_API_KEY explicitly instead.
OPENAI_API_KEY=

# --- Filled in after the token exists ---
# Run `python list_boards.py` once MONDAY_API_TOKEN is set. It prints every board you can
# see, plus its ID and columns. Copy the right IDs here. If left blank, the app will try to
# auto-detect the boards by name (looking for "work order" / "deal" in the board title) but
# an explicit ID is more reliable once you know it.
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=

# --- Optional ---
# Model to use for the agent (needs function/tool calling support). Defaults to "gpt-4o" for a
# direct OpenAI key, or "openai/gpt-oss-120b" (an OpenRouter model slug) when using OpenRouter —
# testing found smaller/cheaper OpenRouter models (e.g. gpt-4o-mini) unreliable at aggregating
# this app's tool results, while gpt-oss-120b matched ground truth exactly at similar cost.
LLM_MODEL=
